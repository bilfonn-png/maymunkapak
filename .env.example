# Vercel → Project → Settings → Environment Variables
PADDLE_ENV=sandbox                 # sandbox while testing, live for real sales
PADDLE_API_KEY=                    # Paddle → Developer tools → Authentication → API key (read transactions, adjustments, subscriptions)
PADDLE_PRICE_IDS=                  # comma-separated Pro price ids, e.g. pri_01...,pri_01...
LICENSE_SECRET=                    # 32+ random characters (openssl rand -base64 32). Changing it invalidates every key.
