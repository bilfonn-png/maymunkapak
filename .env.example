# Vercel → Project → Settings → Environment Variables
PADDLE_ENV=sandbox                 # sandbox while testing, production for real sales
PADDLE_API_KEY=                    # Paddle → Developer tools → Authentication → API key (read: transactions, adjustments)
PADDLE_PRODUCT_ID=pro_01m8bpz6kqmfs3m3518ead6j7q   # only prices of this product give credits (sandbox id)
LICENSE_SECRET=                    # 32+ random characters (openssl rand -base64 32). Changing it invalidates every key.
# Credit usage counter: add the free Upstash Redis integration in Vercel (sets KV_REST_API_URL / KV_REST_API_TOKEN),
# or set these from upstash.com:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
